#!/bin/bash
# pail credential provider: your gcloud login (`gcloud auth login`), no application-default
# credentials needed. The token carries all of your account's access; for a token limited to
# one repository, use gcs-downscoped (or a broker).
set -euo pipefail
case "${1:-}" in
  describe) echo "your gcloud login (gcloud auth print-access-token)"; exit 0 ;;
  get) ;;
  *) echo "usage: pail-credential-gcloud get|describe" >&2; exit 2 ;;
esac
cat >/dev/null # the request: any gs:// or https:// store gets the same token
token=$(gcloud auth print-access-token)
# gcloud hands out its cached token, which may be close to expiry: ask Google when it ends.
exp=$(curl -fsS "https://oauth2.googleapis.com/tokeninfo?access_token=$token" 2>/dev/null | jq -r '.exp // empty' || true)
[[ "$exp" =~ ^[0-9]+$ ]] || exp=$(( $(date +%s) + 300 ))
printf '{"token":"%s","expires_at":%d}\n' "$token" "$exp"
