#!/bin/bash
# A pail credential provider (pail-credential/1) that hands pail a Google token downscoped to one
# repository: read and write objects under gs://<bucket>/<prefix>/ and nothing else.
#
# It is the reference for what a broker does server-side (exchange a broad credential for a
# narrow, short-lived one with a Credential Access Boundary). Here the broad credential is
# the caller's own gcloud login; a broker would use its service account instead and decide
# first whether the caller may have the repository at all.
#
#   pail auth install gcs-downscoped && pail auth use gcs-downscoped --for gs://acme-vcs
#
# Optional: SOURCE_TOKEN_CMD (default `gcloud auth print-access-token`).
set -euo pipefail

case "${1:-}" in
  describe) echo "your gcloud login, downscoped to the one repository (GCS Credential Access Boundary)"; exit 0 ;;
  get) ;;
  *) echo "usage: pail-credential-gcs-downscoped get|describe" >&2; exit 2 ;;
esac
store=$(jq -r .store)
[[ "$store" == gs://* ]] || { echo "gcs-downscoped: not a gs:// store: $store" >&2; exit 1; }
rest=${store#gs://}
bucket=${rest%%/*}
prefix=${rest#"$bucket"}
prefix=${prefix#/}
prefix=${prefix%/}
[[ -n "$prefix" ]] || { echo "gcs-downscoped: refusing to grant a whole bucket ($store)" >&2; exit 1; }

source_token=$(${SOURCE_TOKEN_CMD:-gcloud auth print-access-token})

# Objects under the prefix (get, put, delete), and listing only with that prefix.
boundary=$(jq -cn --arg b "$bucket" --arg p "$prefix/" '{
  accessBoundary: {accessBoundaryRules: [
    {availableResource: ("//storage.googleapis.com/projects/_/buckets/" + $b),
     availablePermissions: ["inRole:roles/storage.objectAdmin"],
     availabilityCondition: {expression:
       ("resource.name.startsWith(\"projects/_/buckets/" + $b + "/objects/" + $p + "\") || " +
        "api.getAttribute(\"storage.googleapis.com/objectListPrefix\", \"\").startsWith(\"" + $p + "\")")}}
  ]}}')

resp=$(curl -sS --fail-with-body https://sts.googleapis.com/v1/token \
  --data-urlencode grant_type=urn:ietf:params:oauth:grant-type:token-exchange \
  --data-urlencode subject_token_type=urn:ietf:params:oauth:token-type:access_token \
  --data-urlencode requested_token_type=urn:ietf:params:oauth:token-type:access_token \
  --data-urlencode "subject_token=$source_token" \
  --data-urlencode "options=$boundary")

jq -c --argjson now "$(date +%s)" '{token: .access_token, expires_at: ($now + (.expires_in // 3600))}' <<<"$resp"
