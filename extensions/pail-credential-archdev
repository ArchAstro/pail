#!/bin/sh
# pail credential provider: your ArchDev login. ArchDev serves your organization's pail
# repositories at <portal>/api/pail/<repo> and checks the token on every request; archdev
# only hands the token to stores on its own portal.
#
#   pail auth install archdev
#   pail auth use archdev --for https://archdev.ai/api/pail --global
#   pail clone "$(archdev pail url team/app)"
case "${1:-}" in
  get|describe) exec archdev pail credential "$1" ;;
  *) echo "usage: pail-credential-archdev get|describe" >&2; exit 2 ;;
esac
