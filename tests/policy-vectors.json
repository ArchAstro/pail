 "comment": "Language-neutral branch-policy vectors for pail's Policy::decide (src/policy.rs). Every enforcement point (pail serve, the ArchDev gateway) must agree. op is read|write|delete; key is relative to the repository.",
 "policies": {
  "std": {
   "version": 1,
   "admins": [
    "role:admin"
   ],
   "gc": [
    "role:gc"
   ],
   "branches": {
    "main": {
     "writers": [
      "lander"
     ],
     "approvals": 1,
     "required_checks": [
      "test"
     ]
    },
    "release/*": {
     "writers": [
      "lander"
     ],
     "approvals": 2
    },
    "_policy": {
     "writers": [
      "role:admin"
     ]
    },
    "*": {
     "writers": [
      "*"
     ]
    }
   }
  },
  "strict": {
   "version": 1,
   "branches": {
    "main": {
     "writers": [
      "lander"
     ]
    }
   }
  },
  "private": {
   "version": 1,
   "readers": [
    "group:eng",
    "user:bob"
   ],
   "admins": [
    "user:root"
   ],
   "gc": [
    "user:gcbot"
   ],
   "branches": {
    "main": {
     "writers": [
      "group:eng"
     ]
    },
    "pr/*": {
     "writers": [
      "*"
     ]
    }
   }
  },
  "nested": {
   "version": 1,
   "branches": {
    "pr/*": {
     "writers": [
      "group:eng"
     ]
    },
    "pr/a/*": {
     "writers": [
      "user:alice"
     ]
    },
    "pr/a/b": {
     "writers": [
      "user:bob"
     ]
    },
    "release/*": {
     "writers": [
      "lander"
     ]
    },
    "release/hotfix": {
     "writers": [
      "*"
     ]
    }
   }
  },
  "empty": {
   "version": 1
  },
  "case_sensitive": {
   "version": 1,
   "Readers": [
    "user:nobody-else"
   ],
   "Admins": [
    "*"
   ],
   "branches": {
    "*": {
     "Writers": [
      "*"
     ]
    }
   }
  },
  "closed_readers": {
   "version": 1,
   "readers": [],
   "branches": {
    "*": {
     "writers": [
      "*"
     ]
    }
   }
  }
 },
