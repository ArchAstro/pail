{
  "name": "pail-web",
  "version": "0.1.0",
  "description": "A standalone web UI for browsing pail repositories: code, commits, pull requests and checks.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "pail-web": "dist/server/index.js" },
  "scripts": {
    "dev": "tsx watch server/index.ts & vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "demo": "node scripts/demo.mjs",
    "demo:build": "node scripts/make-demo.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@fontsource-variable/schibsted-grotesk": "^5.1.0",
    "diff": "^7.0.0",
    "dompurify": "^3.2.0",
    "express": "^4.21.0",
    "highlight.js": "^11.10.0",
    "marked": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/diff": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
