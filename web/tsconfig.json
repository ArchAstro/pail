{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["vite/client", "@testing-library/jest-dom"],
    "isolatedModules": true, "resolveJsonModule": true
  },
  "include": ["src", "shared", "test/**/*.tsx", "vite.config.ts"]
}
