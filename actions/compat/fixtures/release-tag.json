{
  "workflow": "workflows/release-tag.yml",
  "scenarios": [
    {
      "name": "tag v1.2.3",
      "input": {
        "event": "push",
        "ref": "refs/tags/v1.2.3"
      },
      "plan": {
        "workflow": "release-tag.yml",
        "name": "release-tag",
        "triggers": [
          "push"
        ],
        "input": {
          "event": "push",
          "ref": "refs/tags/v1.2.3"
        },
        "triggered": true,
        "reason": "push to tag v1.2.3",
        "jobs": [
          {
            "id": "build (macos-latest, aarch64-apple-darwin)",
            "job_id": "build",
            "runs_on": [
              "${{ matrix.os }}"
            ],
            "matrix": {
              "os": "macos-latest",
              "target": "aarch64-apple-darwin"
            },
            "fail_fast": false,
            "steps": 5
          },
          {
            "id": "build (ubuntu-22.04, x86_64-unknown-linux-gnu)",
            "job_id": "build",
            "runs_on": [
              "${{ matrix.os }}"
            ],
            "matrix": {
              "os": "ubuntu-22.04",
              "target": "x86_64-unknown-linux-gnu"
            },
            "fail_fast": false,
            "steps": 5
          },
          {
            "id": "build (ubuntu-22.04-arm, aarch64-unknown-linux-gnu)",
            "job_id": "build",
            "runs_on": [
              "${{ matrix.os }}"
            ],
            "matrix": {
              "os": "ubuntu-22.04-arm",
              "target": "aarch64-unknown-linux-gnu"
            },
            "fail_fast": false,
            "steps": 5
          },
          {
            "id": "publish",
            "job_id": "publish",
            "needs": [
              "build"
            ],
            "runs_on": [
              "ubuntu-latest"
            ],
            "steps": 2
          }
        ],
        "stages": [
          [
            "build (macos-latest, aarch64-apple-darwin)",
            "build (ubuntu-22.04, x86_64-unknown-linux-gnu)",
            "build (ubuntu-22.04-arm, aarch64-unknown-linux-gnu)"
          ],
          [
            "publish"
          ]
        ],
        "actions": [
          "actions/checkout@v4",
          "actions/download-artifact@v4",
          "actions/upload-artifact@v4",
          "dtolnay/rust-toolchain@stable"
        ]
      }
    },
    {
      "name": "tag v1.2 does not match the pattern",
      "input": {
        "event": "push",
        "ref": "refs/tags/v1.2"
      },
      "plan": {
        "workflow": "release-tag.yml",
        "name": "release-tag",
        "triggers": [
          "push"
        ],
        "input": {
          "event": "push",
          "ref": "refs/tags/v1.2"
        },
        "triggered": false,
        "reason": "tag v1.2 does not match the tags filter"
      }
    },
    {
      "name": "branch push",
      "input": {
        "event": "push",
        "ref": "main"
      },
      "plan": {
        "workflow": "release-tag.yml",
        "name": "release-tag",
        "triggers": [
          "push"
        ],
        "input": {
          "event": "push",
          "ref": "main"
        },
        "triggered": false,
        "reason": "only tags are filtered: a branch push does not trigger"
      }
    }
  ]
}
