{
  "workflow": "workflows/matrix-include-only.yml",
  "scenarios": [
    {
      "name": "push",
      "input": {
        "event": "push",
        "ref": "main"
      },
      "plan": {
        "workflow": "matrix-include-only.yml",
        "name": "matrix-include-only",
        "triggers": [
          "push"
        ],
        "input": {
          "event": "push",
          "ref": "main"
        },
        "triggered": true,
        "reason": "push to branch main",
        "jobs": [
          {
            "id": "target (macos-latest, aarch64-apple-darwin)",
            "job_id": "target",
            "runs_on": [
              "${{ matrix.runner }}"
            ],
            "matrix": {
              "runner": "macos-latest",
              "triple": "aarch64-apple-darwin"
            },
            "fail_fast": true,
            "steps": 1
          },
          {
            "id": "target (ubuntu-22.04, x86_64-unknown-linux-gnu)",
            "job_id": "target",
            "runs_on": [
              "${{ matrix.runner }}"
            ],
            "matrix": {
              "runner": "ubuntu-22.04",
              "triple": "x86_64-unknown-linux-gnu"
            },
            "fail_fast": true,
            "steps": 1
          },
          {
            "id": "target (ubuntu-22.04-arm, aarch64-unknown-linux-gnu)",
            "job_id": "target",
            "runs_on": [
              "${{ matrix.runner }}"
            ],
            "matrix": {
              "runner": "ubuntu-22.04-arm",
              "triple": "aarch64-unknown-linux-gnu"
            },
            "fail_fast": true,
            "steps": 1
          }
        ],
        "stages": [
          [
            "target (macos-latest, aarch64-apple-darwin)",
            "target (ubuntu-22.04, x86_64-unknown-linux-gnu)",
            "target (ubuntu-22.04-arm, aarch64-unknown-linux-gnu)"
          ]
        ]
      }
    }
  ]
}
