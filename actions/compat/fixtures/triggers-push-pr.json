{
  "workflow": "workflows/triggers-push-pr.yml",
  "scenarios": [
    {
      "name": "push main, src changed",
      "input": {
        "event": "push",
        "ref": "main",
        "paths": [
          "src/lib.rs"
        ]
      },
      "plan": {
        "workflow": "triggers-push-pr.yml",
        "name": "triggers-push-pr",
        "triggers": [
          "pull_request",
          "push"
        ],
        "input": {
          "event": "push",
          "ref": "main",
          "paths": [
            "src/lib.rs"
          ]
        },
        "triggered": true,
        "reason": "push to branch main",
        "jobs": [
          {
            "id": "build",
            "job_id": "build",
            "runs_on": [
              "ubuntu-latest"
            ],
            "steps": 2
          },
          {
            "id": "test",
            "job_id": "test",
            "needs": [
              "build"
            ],
            "runs_on": [
              "ubuntu-latest"
            ],
            "if": "github.event_name == 'push' || !github.event.pull_request.draft",
            "if_static": "deferred",
            "steps": 2
          }
        ],
        "stages": [
          [
            "build"
          ],
          [
            "test"
          ]
        ],
        "actions": [
          "actions/checkout@v4"
        ]
      }
    },
    {
      "name": "push main, only docs and src markdown",
      "input": {
        "event": "push",
        "ref": "main",
        "paths": [
          "docs/a.md",
          "src/readme.md"
        ]
      },
      "plan": {
        "workflow": "triggers-push-pr.yml",
        "name": "triggers-push-pr",
        "triggers": [
          "pull_request",
          "push"
        ],
        "input": {
          "event": "push",
          "ref": "main",
          "paths": [
            "docs/a.md",
            "src/readme.md"
          ]
        },
        "triggered": false,
        "reason": "no changed file passes the paths filter"
      }
    },
