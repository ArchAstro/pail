{
  "workflow": "workflows/oss-triage-bot.yml",
  "scenarios": [
    {
      "name": "issue opened",
      "input": {
        "event": "issues",
        "type": "opened"
      },
      "plan": {
        "workflow": "oss-triage-bot.yml",
        "name": "oss-triage-bot",
        "triggers": [
          "issue_comment",
          "issues",
          "pull_request_target",
          "schedule"
        ],
        "input": {
          "event": "issues",
          "type": "opened"
        },
        "triggered": true,
        "reason": "issues is in on:",
        "jobs": [
          {
            "id": "label",
            "job_id": "label",
            "runs_on": [
              "ubuntu-latest"
            ],
            "if": "github.event_name == 'pull_request_target'",
            "if_static": "false",
            "steps": 1
          },
          {
            "id": "slash-commands",
            "job_id": "slash-commands",
            "runs_on": [
              "ubuntu-latest"
            ],
            "if": "github.event_name == 'issue_comment' && startsWith(github.event.comment.body, '/rebase')",
            "if_static": "deferred",
            "steps": 1
          },
          {
            "id": "stale",
            "job_id": "stale",
            "runs_on": [
              "ubuntu-latest"
            ],
            "if": "github.event_name == 'schedule'",
            "if_static": "false",
            "steps": 1
          },
          {
            "id": "welcome",
            "job_id": "welcome",
            "runs_on": [
              "ubuntu-latest"
            ],
            "if": "github.event_name == 'issues' && github.event.action == 'opened'",
            "if_static": "deferred",
            "steps": 1
          }
        ],
        "stages": [
          [
            "label",
            "slash-commands",
            "stale",
            "welcome"
          ]
        ],
        "actions": [
          "actions/github-script@v7",
          "actions/labeler@v5",
          "actions/stale@v9"
        ]
      }
    },
