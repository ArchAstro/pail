{
  "workflow": "workflows/triggers-schedule.yml",
  "scenarios": [
    {
      "name": "nightly cron",
      "input": {
        "event": "schedule",
        "ref": "main",
        "cron": "17 3 * * *"
      },
      "plan": {
        "workflow": "triggers-schedule.yml",
        "name": "triggers-schedule",
        "triggers": [
          "schedule",
          "workflow_dispatch"
        ],
        "input": {
          "event": "schedule",
          "ref": "main",
          "cron": "17 3 * * *"
        },
        "triggered": true,
        "reason": "cron 17 3 * * *",
        "jobs": [
          {
            "id": "nightly",
            "job_id": "nightly",
            "runs_on": [
              "ubuntu-latest"
            ],
            "timeout_minutes": "90",
            "steps": 2
          },
          {
            "id": "weekly-report",
            "job_id": "weekly-report",
            "needs": [
              "nightly"
            ],
            "runs_on": [
              "ubuntu-latest"
            ],
            "if": "github.event.schedule == '0 12 * * 1'",
            "if_static": "deferred",
            "steps": 1
          }
        ],
        "stages": [
          [
            "nightly"
          ],
          [
            "weekly-report"
          ]
        ],
        "actions": [
          "actions/checkout@v4"
        ]
      }
    },
    {
